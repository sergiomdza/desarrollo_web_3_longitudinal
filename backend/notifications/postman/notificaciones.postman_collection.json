      "name": "CRUD de notificaciones",
      "item": [
        {
          "name": "1. Crear notificación",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/notificaciones",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "notificaciones"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigo\": \"{{codigoDemo}}\",\n  \"tipo\": \"notificacion_general\",\n  \"canal\": \"email\",\n  \"destinatario_id\": \"USR-DEMO\",\n  \"prestamo_id\": \"PREST-DEMO\",\n  \"titulo\": \"Bienvenido al sistema\",\n  \"mensaje\": \"Tu cuenta fue creada correctamente.\",\n  \"estado\": \"pendiente\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"codigoDemo\", \"DEMO-\" + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201 Created\", () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test(\"Regresa id y created_at\", () => {",
                  "    pm.expect(b.id).to.be.a(\"string\");",
                  "    pm.expect(b.created_at).to.exist;",
                  "});",
                  "pm.test(\"Guarda los datos enviados\", () => {",
                  "    pm.expect(b.codigo).to.eql(pm.collectionVariables.get(\"codigoDemo\"));",
                  "    pm.expect(b.estado).to.eql(\"pendiente\");",
                  "});",
                  "pm.collectionVariables.set(\"notificacionId\", b.id);"
                ]
              }
            }
          ]
        },
