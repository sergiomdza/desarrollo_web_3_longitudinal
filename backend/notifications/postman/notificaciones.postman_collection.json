    {
      "name": "Eventos de Préstamos",
      "item": [
        {
          "name": "1. Préstamo aprobado → confirmación + recordatorio",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/eventos/prestamos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "eventos",
                "prestamos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"evento\": \"prestamo_aprobado\",\n  \"prestamo_id\": \"{{prestamoId}}\",\n  \"usuario_id\": \"USR-100\",\n  \"activo_nombre\": \"Proyector Epson\",\n  \"fecha_devolucion\": \"{{fechaDevolucion}}\",\n  \"canal\": \"email\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Préstamos (Equipo #4) avisa que aprobó un préstamo."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"prestamoId\", \"PREST-\" + Date.now());",
                  "const d = new Date(Date.now() + 7 * 24 * 3600 * 1000);",
                  "pm.collectionVariables.set(\"fechaDevolucion\", d.toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const n = pm.response.json().notificaciones;",
                  "pm.test(\"Genera 2 notificaciones\", () => pm.expect(n.length).to.eql(2));",
                  "pm.test(\"Confirmación de aprobación enviada\", () => {",
                  "    pm.expect(n[0].tipo).to.eql(\"confirmacion_aprobacion\");",
                  "    pm.expect(n[0].estado).to.eql(\"enviada\");",
                  "});",
                  "pm.test(\"Recordatorio programado 1 día antes de la devolución\", () => {",
                  "    pm.expect(n[1].tipo).to.eql(\"recordatorio_devolucion\");",
                  "    pm.expect(n[1].estado).to.eql(\"pendiente\");",
                  "    const esperado = new Date(pm.collectionVariables.get(\"fechaDevolucion\")).getTime() - 24 * 3600 * 1000;",
                  "    pm.expect(new Date(n[1].fecha_programada + \"Z\").getTime()).to.be.closeTo(esperado, 1000);",
                  "});",
                  "pm.collectionVariables.set(\"aprobacionId\", n[0].id);"
                ]
              }
            }
          ]
        },
